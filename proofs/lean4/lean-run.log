@Escalation.consumed_not_reused : ∀ {strict : Bool} {c : Escalation.Case},
  Escalation.Reachable strict c →
    ∀ (r : Escalation.Rung),
      r ∈ c.log →
        ∀ (f : Escalation.Hash),
          r.roundBond = some f → ∀ (r' : Escalation.Rung), r' ∈ c.log → r.round < r'.round → r'.roundBond ≠ some f
