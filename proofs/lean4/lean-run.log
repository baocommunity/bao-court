oracle_single_finality : ∀ (s : SystemState) (e : Epoch) (m1 m2 : Message),
  State.Finalized s e m1 ∧ State.Finalized s e m2 → m1 = m2
@finalize_barrier : ∀ {s s' : SystemState} {e : Epoch} {c : CaseId},
  step s (Event.finalize e c) = some s' →
    ∃ se,
      look (e, c) s.sessions = some se ∧
        se.phase = Phase.feeSettlement ∧
          se.verdict.isSome = true ∧ s' = { sessions := updateAt (e, c) (Effect.advance Phase.final) s.sessions }

